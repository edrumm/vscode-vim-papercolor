{
  "name": "vscode-vim-papercolor",
  "displayName": "vscode-vim-papercolor",
  "description": "a port of https://github.com/NLKNguyen/papercolor-theme to vscode",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "PaperColor Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/PaperColorDark.json"
      },
      {
        "label": "PaperColor Light",
        "uiTheme": "vs",
        "path": "./themes/PaperColorLight.json"
      }
    ]
  },
  "scripts": {
    "build": "node build/index.js"
  }
}
